{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true, "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src"]
}
